    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "health_expenditure_wide = pd.read_csv(\n",
        "    r\"C:/Users/USER/Documents/GitHub/co2_emissions_demo/data/hiv-prevalance/health-expenditure/current_health_expenditure.csv\",\n",
        "    engine=\"python\",  # more flexible parser\n",
        "    on_bad_lines=\"skip\",  # skips problematic rows\n",
        ")\n",
        "\n",
        "# HIV prevelence data\n",
        "hiv_data = pd.read_csv(\n",
        "     r\"C:\\Users\\USER\\Documents\\GitHub\\co2_emissions_demo\\data\\hiv-prevalance\\health-expenditure\\ddf--datapoints--estimated_hiv_prevalence_ages_15_49--by--country--year.csv\",\n",
        "    engine=\"python\",\n",
        ")"
      ],
      "id": "fc6a8b32",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "# Convert column names to lowercase and remove spaces\n",
        "hiv_data.columns = hiv_data.columns.str.lower().str.strip()\n",
        "\n",
        "\n",
        "# Rename country column if necessary\n",
        "if \"country name\" in hiv_data.columns:\n",
        "    hiv_data = hiv_data.rename(\n",
        "        columns={\"country name\": \"country\"}\n",
        "    )\n",
        "\n",
        "elif \"country\" not in hiv_data.columns:\n",
        "    # Use the first column as country if no country column exists\n",
        "    hiv_data = hiv_data.rename(\n",
        "        columns={hiv_data.columns[0]: \"country\"}\n",
        "    )\n",
        "\n",
        "\n",
        "# Clean country names\n",
        "hiv_data[\"country\"] = (\n",
        "    hiv_data[\"country\"]\n",
        "    .astype(str)\n",
        "    .str.strip()\n",
        ")\n",
        "\n",
        "\n",
        "# Create a readable country label\n",
        "hiv_data[\"country_label\"] = (\n",
        "    hiv_data[\"country\"]\n",
        "    .str.replace(\"_\", \" \", regex=False)\n",
        "    .str.title()\n",
        ")"
      ],
      "id": "e490ce0f",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "# Country-name differences between the HIV dataset # and the health expenditure dataset\n",
        "country_map = {\n",
        "    \"bahamas\": \"Bahamas,  The\",\n",
        "    \"cape_verde\": \"Cabo Verde\",\n",
        "    \"congo_rep\": \"Congo,  Rep.\",\n",
        "    \"cote_d_ivoire\": \"Cote d'Ivoire\",\n",
        "    \"egypt\": \"Egypt,  Arab Rep.\",\n",
        "    \"gambia\": \"Gambia,  The\",\n",
        "    \"guinea_bissau\": \"Guinea-Bissau\",\n",
        "    \"iran\": \"Iran,  Islamic Rep.\",\n",
        "    \"lao\": \"Lao PDR\",\n",
        "    \"sao_tome_and_principe\": \"Sao Tome and Principe\",\n",
        "    \"south_korea\": \"Korea,  Rep.\",\n",
        "    \"swaziland\": \"Eswatini\",\n",
        "    \"trinidad_and_tobago\": \"Trinidad and Tobago\",\n",
        "    \"turkey\": \"Turkiye\",\n",
        "    \"venezuela\": \"Venezuela,  RB\",\n",
        "    \"yemen\": \"Yemen,  Rep.\",\n",
        "}\n",
        "\n",
        "\n",
        "# Create a World Bank-compatible country name\n",
        "hiv_data[\"wb_name\"] = (\n",
        "    hiv_data[\"country\"]\n",
        "    .map(country_map)\n",
        "    .fillna(hiv_data[\"country\"].str.replace(\"_\", \" \", regex=False).str.title())\n",
        ")"
      ],
      "id": "65203a84",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "# Find columns containing years\n",
        "year_columns = [\n",
        "    column for column in health_expenditure_wide.columns if str(column).isdigit()\n",
        "]\n",
        "\n",
        "# Convert from wide format to long format\n",
        "health_expenditure_long = health_expenditure_wide.melt(\n",
        "    id_vars=[\"Country Name\", \"Country Code\", \"Indicator Name\", \"Indicator Code\"],\n",
        "    value_vars=year_columns,\n",
        "    var_name=\"year\",\n",
        "    value_name=\"health_expenditure\",\n",
        ")\n",
        "\n",
        "\n",
        "# Convert year to numeric\n",
        "health_expenditure_long[\"year\"] = pd.to_numeric(\n",
        "    health_expenditure_long[\"year\"], errors=\"coerce\"\n",
        ")\n",
        "\n",
        "\n",
        "# Convert health expenditure to numeric\n",
        "health_expenditure_long[\"health_expenditure\"] = pd.to_numeric(\n",
        "    health_expenditure_long[\"health_expenditure\"], errors=\"coerce\"\n",
        ")"
      ],
      "id": "5f154f45",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "hiv_data[\"year\"] = pd.to_numeric(\n",
        "    hiv_data[\"year\"],\n",
        "    errors=\"coerce\"\n",
        ")\n",
        "\n",
        "hiv_data[\"estimated_hiv_prevalence_ages_15_49\"] = pd.to_numeric(\n",
        "    hiv_data[\"estimated_hiv_prevalence_ages_15_49\"],\n",
        "    errors=\"coerce\"\n",
        ")"
      ],
      "id": "57a16d1d",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "merged_data = hiv_data.merge(\n",
        "    health_expenditure_long,\n",
        "    left_on=[\"wb_name\", \"year\"],\n",
        "    right_on=[\"Country Name\", \"year\"],\n",
        "    how=\"inner\"\n",
        ")\n",
        "\n",
        "\n",
        "# Remove missing values\n",
        "merged_data = merged_data.dropna(\n",
        "    subset=[\n",
        "        \"estimated_hiv_prevalence_ages_15_49\",\n",
        "        \"health_expenditure\"\n",
        "    ]\n",
        ").copy()"
      ],
      "id": "90a80395",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "relationship_data = merged_data[\n",
        "    (merged_data[\"year\"] >= 2000) &\n",
        "    (merged_data[\"year\"] <= 2011)\n",
        "].copy()"
      ],
      "id": "af080f8c",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Latest HIV year\n",
