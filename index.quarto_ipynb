{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "title: \"HIV Prevalence and Health Expenditure\" \n",
        "author: \"Sele Maphalala\" \n",
        "format: \n",
        " dashboard: \n",
        "  orientation: columns \n",
        "  theme: cosmo\n",
        "   \n",
        "---\n"
      ],
      "id": "b40cfd81"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import pandas as pd\n",
        "import plotly.express as px"
      ],
      "id": "8f597e19",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "health_expenditure_wide = pd.read_csv(\n",
        "    r\"C:/Users/USER/Desktop/graph_courses _python/misc_public-main/misc_public-main/current_health_expenditure.csv\",\n",
        "    engine=\"python\",          # more flexible parser\n",
        "    on_bad_lines=\"skip\"       # skips problematic rows\n",
        ")\n",
        "\n",
        "# HIV prevelence data\n",
        "hiv_data = pd.read_csv(\n",
        "    r\"C:/Users/USER\\Desktop/graph_courses _python/ddf--datapoints--estimated_hiv_prevalence_ages_15_49--by--country--year.csv\",\n",
        "    engine=\"python\"\n",
        ")"
      ],
      "id": "37309765",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "# Convert column names to lowercase and remove spaces\n",
        "hiv_data.columns = hiv_data.columns.str.lower().str.strip()\n",
        "\n",
        "print(\"HIV columns after cleaning:\")\n",
        "print(hiv_data.columns.tolist())\n",
        "\n",
        "\n",
        "# Rename country column if necessary\n",
        "if \"country name\" in hiv_data.columns:\n",
        "    hiv_data = hiv_data.rename(\n",
        "        columns={\"country name\": \"country\"}\n",
        "    )\n",
        "\n",
        "elif \"country\" not in hiv_data.columns:\n",
        "    # Use the first column as country if no country column exists\n",
        "    hiv_data = hiv_data.rename(\n",
        "        columns={hiv_data.columns[0]: \"country\"}\n",
        "    )\n",
        "\n",
        "\n",
        "# Clean country names\n",
        "hiv_data[\"country\"] = (\n",
        "    hiv_data[\"country\"]\n",
        "    .astype(str)\n",
        "    .str.strip()\n",
        ")\n",
        "\n",
        "\n",
        "# Create a readable country label\n",
        "hiv_data[\"country_label\"] = (\n",
        "    hiv_data[\"country\"]\n",
        "    .str.replace(\"_\", \" \", regex=False)\n",
        "    .str.title()\n",
        ")"
      ],
      "id": "3df37669",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "# Country-name differences between the HIV dataset # and the health expenditure dataset\n",
        "country_map = {\n",
        "    \"bahamas\": \"Bahamas,  The\",\n",
        "    \"cape_verde\": \"Cabo Verde\",\n",
        "    \"congo_rep\": \"Congo,  Rep.\",\n",
        "    \"cote_d_ivoire\": \"Cote d'Ivoire\",\n",
        "    \"egypt\": \"Egypt,  Arab Rep.\",\n",
        "    \"gambia\": \"Gambia,  The\",\n",
        "    \"guinea_bissau\": \"Guinea-Bissau\",\n",
        "    \"iran\": \"Iran,  Islamic Rep.\",\n",
        "    \"lao\": \"Lao PDR\",\n",
        "    \"sao_tome_and_principe\": \"Sao Tome and Principe\",\n",
        "    \"south_korea\": \"Korea,  Rep.\",\n",
        "    \"swaziland\": \"Eswatini\",\n",
        "    \"trinidad_and_tobago\": \"Trinidad and Tobago\",\n",
        "    \"turkey\": \"Turkiye\",\n",
        "    \"venezuela\": \"Venezuela,  RB\",\n",
        "    \"yemen\": \"Yemen,  Rep.\",\n",
        "}\n",
        "\n",
        "\n",
        "# Create a World Bank-compatible country name\n",
        "hiv_data[\"wb_name\"] = (\n",
        "    hiv_data[\"country\"]\n",
        "    .map(country_map)\n",
        "    .fillna(hiv_data[\"country\"].str.replace(\"_\", \" \", regex=False).str.title())\n",
        ")"
      ],
      "id": "6eafebbe",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "# Find columns containing years\n",
        "year_columns = [\n",
        "    column for column in health_expenditure_wide.columns if str(column).isdigit()\n",
        "]\n",
        "\n",
        "print(\"Year columns found:\")\n",
        "print(year_columns[:10])\n",
        "\n",
        "\n",
        "# Convert from wide format to long format\n",
        "health_expenditure_long = health_expenditure_wide.melt(\n",
        "    id_vars=[\"Country Name\", \"Country Code\", \"Indicator Name\", \"Indicator Code\"],\n",
        "    value_vars=year_columns,\n",
        "    var_name=\"year\",\n",
        "    value_name=\"health_expenditure\",\n",
        ")\n",
        "\n",
        "\n",
        "# Convert year to numeric\n",
        "health_expenditure_long[\"year\"] = pd.to_numeric(\n",
        "    health_expenditure_long[\"year\"], errors=\"coerce\"\n",
        ")\n",
        "\n",
        "\n",
        "# Convert health expenditure to numeric\n",
        "health_expenditure_long[\"health_expenditure\"] = pd.to_numeric(\n",
        "    health_expenditure_long[\"health_expenditure\"], errors=\"coerce\"\n",
        ")\n",
        "\n",
        "\n",
        "print(health_expenditure_long.head())"
      ],
      "id": "b0acfa4e",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "hiv_data[\"year\"] = pd.to_numeric(\n",
        "    hiv_data[\"year\"],\n",
        "    errors=\"coerce\"\n",
        ")\n",
        "\n",
        "hiv_data[\"estimated_hiv_prevalence_ages_15_49\"] = pd.to_numeric(\n",
        "    hiv_data[\"estimated_hiv_prevalence_ages_15_49\"],\n",
        "    errors=\"coerce\"\n",
        ")"
      ],
      "id": "58c98bd5",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "merged_data = hiv_data.merge(\n",
        "    health_expenditure_long,\n",
        "    left_on=[\"wb_name\", \"year\"],\n",
        "    right_on=[\"Country Name\", \"year\"],\n",
        "    how=\"inner\"\n",
        ")\n",
        "\n",
        "\n",
        "# Remove missing values\n",
        "merged_data = merged_data.dropna(\n",
        "    subset=[\n",
        "        \"estimated_hiv_prevalence_ages_15_49\",\n",
        "        \"health_expenditure\"\n",
        "    ]\n",
        ").copy()\n",
        "\n",
        "\n",
        "print(\"Merged data:\")\n",
        "print(merged_data.head())\n",
        "print(\"Number of rows:\", len(merged_data))"
      ],
      "id": "1c7b9f4a",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "relationship_data = merged_data[\n",
        "    (merged_data[\"year\"] >= 2000) &\n",
        "    (merged_data[\"year\"] <= 2011)\n",
        "].copy()"
      ],
      "id": "2bbbe4c0",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Latest HIV year\n",
        "hiv_latest_year = int(\n",
        "    hiv_data[\"year\"].max()\n",
        ")\n",
        "\n",
        "hiv_latest_data = hiv_data[\n",
        "    hiv_data[\"year\"] == hiv_latest_year\n",
        "].dropna(\n",
        "    subset=[\"estimated_hiv_prevalence_ages_15_49\"]\n",
        ").copy()"
      ],
      "id": "4766b8a5",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "# Latest health expenditure year\n",
        "\n",
        "health_latest_year = int(\n",
        "    health_expenditure_long.loc[\n",
        "        health_expenditure_long[\"health_expenditure\"].notna(), \"year\"\n",
        "    ].max()\n",
        ")\n",
        "\n",
        "\n",
        "health_latest_data = (\n",
        "    health_expenditure_long[health_expenditure_long[\"year\"] == health_latest_year]\n",
        "    .dropna(subset=[\"health_expenditure\"])\n",
        "    .copy()\n",
        ")"
      ],
      "id": "144acfa3",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "hiv_country_names = set(\n",
        "    hiv_data[\"wb_name\"].dropna().unique()\n",
        ")\n",
        "\n",
        "\n",
        "health_latest_countries = health_latest_data[\n",
        "    health_latest_data[\"Country Name\"].isin(hiv_country_names)\n",
        "].copy()"
      ],
      "id": "003cd1d8",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "top_hiv = (\n",
        "    hiv_latest_data\n",
        "    .sort_values(\n",
        "        \"estimated_hiv_prevalence_ages_15_49\",\n",
        "        ascending=False\n",
        "    )\n",
        "    .head(10)\n",
        ")\n",
        "\n",
        "print(top_hiv[\n",
        "    [\n",
        "        \"country_label\",\n",
        "        \"estimated_hiv_prevalence_ages_15_49\"\n",
        "    ]\n",
        "])"
      ],
      "id": "0e1ab3f4",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "top_health_expenditure = (\n",
        "    health_latest_countries\n",
        "    .sort_values(\n",
        "        \"health_expenditure\",\n",
        "        ascending=False\n",
        "    )\n",
        "    .head(10)\n",
        ")\n",
        "\n",
        "print(top_health_expenditure[\n",
        "    [\n",
        "        \"Country Name\",\n",
        "        \"health_expenditure\"\n",
        "    ]\n",
        "])"
      ],
      "id": "930c6b4a",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "health_country_series = health_expenditure_long[\n",
        "    health_expenditure_long[\"Country Name\"].isin(\n",
        "        hiv_country_names\n",
        "    )\n",
        "].copy()\n",
        "\n",
        "\n",
        "health_expenditure_trend = (\n",
        "    health_country_series\n",
        "    .groupby(\"year\", as_index=False)[\"health_expenditure\"]\n",
        "    .mean()\n",
        "    .dropna()\n",
        ")\n",
        "\n",
        "\n",
        "print(health_expenditure_trend.head())"
      ],
      "id": "d3fd5e85",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "hiv_trend = (\n",
        "    hiv_data\n",
        "    .groupby(\n",
        "        \"year\",\n",
        "        as_index=False\n",
        "    )[\"estimated_hiv_prevalence_ages_15_49\"]\n",
        "    .mean()\n",
        "    .dropna()\n",
        ")\n",
        "\n",
        "\n",
        "print(hiv_trend.head())"
      ],
      "id": "74ae54b6",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "relationship_latest_year = int(\n",
        "    relationship_data[\"year\"].max()\n",
        ")\n",
        "\n",
        "\n",
        "relationship_latest_data = relationship_data[\n",
        "    relationship_data[\"year\"] == relationship_latest_year\n",
        "].copy()\n",
        "\n",
        "\n",
        "print(\n",
        "    \"Latest common year:\",\n",
        "    relationship_latest_year\n",
        ")"
      ],
      "id": "4fe1726e",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "relationship_latest_data[\"HIV prevalence (%)\"] = relationship_latest_data[\n",
        "    \"estimated_hiv_prevalence_ages_15_49\"\n",
        "]\n",
        "\n",
        "\n",
        "relationship_latest_data[\"Health expenditure (US$ per capita)\"] = (\n",
        "    relationship_latest_data[\"health_expenditure\"]\n",
        ")\n",
        "\n",
        "\n",
        "relationship_table = (\n",
        "    relationship_latest_data[\n",
        "        [\"country_label\", \"HIV prevalence (%)\", \"Health expenditure (US$ per capita)\"]\n",
        "    ]\n",
        "    .sort_values(\"HIV prevalence (%)\", ascending=False)\n",
        "    .head(10)\n",
        ")\n",
        "\n",
        "\n",
        "print(relationship_table)"
      ],
      "id": "a6974652",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "print(f\"Latest HIV year: {hiv_latest_year}\")\n",
        "print(f\"Countries: {hiv_latest_data['country'].nunique()}\")\n",
        "print(\n",
        "    f\"Highest prevalence: \"\n",
        "    f\"{hiv_latest_data['estimated_hiv_prevalence_ages_15_49'].max():.1f}%\"\n",
        ")"
      ],
      "id": "b6e8fd53",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Overview \n",
        "\n",
        "## Project Overview \n",
        "\n",
        "<div class=\"intro-box\"> \n",
        "### HIV Prevalence, Health Expenditure & ARV Treatment HIV remains an important public health and health-security concern, particularly in countries where health systems face challenges in prevention, testing, treatment, and long-term care. Adequate health financing is important for strengthening health services, including HIV prevention, testing, treatment, and access to antiretroviral (ARV) therapy. This dashboard explores HIV prevalence among people aged 15–49 and current health expenditure per capita across countries and over time. It examines HIV trends, differences in health-system investment, geographical patterns, and the relationship between HIV prevalence and health expenditure. The analysis uses Python, Pandas, NumPy, and Plotly to clean, analyse, and visualise publicly available health data. \n",
        "\n",
        "</div> \n",
        "\n",
        "## Key Indicators \n",
        "\n",
        "::: {.columns} \n",
        "\n",
        "::: {.column} \n",
        "\n",
        "<div class=\"kpi-card\"> \n",
        "\n",
        "<div class=\"kpi-value\"> {{ hiv_latest_year }} </div> \n",
        "\n",
        "<div class=\"kpi-label\"> Latest HIV prevalence year </div> \n",
        "\n",
        "</div>\n",
        "\n",
        "\n",
        "\n",
        "# HIV Prevalence Analysis"
      ],
      "id": "bed9e98f"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "hiv_trend = ( hiv_data .groupby(\"year\", as_index=False) [\"estimated_hiv_prevalence_ages_15_49\"] .mean() .dropna() )"
      ],
      "id": "224951a5",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "fig_hiv_trend = px.line(\n",
        "    hiv_trend,\n",
        "    x=\"year\",\n",
        "    y=\"estimated_hiv_prevalence_ages_15_49\",\n",
        "    markers=True,\n",
        "    title=\"Average HIV Prevalence Among People Aged 15–49 Over Time\",\n",
        "    labels={\n",
        "        \"year\": \"Year\",\n",
        "        \"estimated_hiv_prevalence_ages_15_49\": \"HIV prevalence (%)\"\n",
        "    }\n",
        ")\n",
        "\n",
        "fig_hiv_trend.update_layout(\n",
        "    height=500,\n",
        "    xaxis_title=\"Year\",\n",
        "    yaxis_title=\"HIV prevalence (%)\"\n",
        ")\n",
        "\n",
        "fig_hiv_trend.show()"
      ],
      "id": "17b497dd",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "top_hiv_plot = top_hiv.sort_values(\n",
        "    \"estimated_hiv_prevalence_ages_15_49\", ascending=True\n",
        ")\n",
        "\n",
        "fig_hiv_top10 = px.bar(\n",
        "    top_hiv_plot,\n",
        "    x=\"estimated_hiv_prevalence_ages_15_49\",\n",
        "    y=\"country_label\",\n",
        "    orientation=\"h\",\n",
        "    title=f\"Top 10 Countries by HIV Prevalence ({hiv_latest_year})\",\n",
        "    labels={\n",
        "        \"estimated_hiv_prevalence_ages_15_49\": \"HIV prevalence (%)\",\n",
        "        \"country_label\": \"Country\",\n",
        "    },\n",
        "    text=\"estimated_hiv_prevalence_ages_15_49\",\n",
        ")\n",
        "\n",
        "fig_hiv_top10.update_traces(texttemplate=\"%{text:.1f}%\", textposition=\"outside\")\n",
        "\n",
        "fig_hiv_top10.update_layout(\n",
        "    height=550, yaxis_title=\"Country\", xaxis_title=\"HIV prevalence (%)\"\n",
        ")\n",
        "\n",
        "fig_hiv_top10.show()"
      ],
      "id": "eabd5802",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "fig_hiv_map = px.choropleth(\n",
        "    hiv_latest_data,\n",
        "    locations=\"country\",\n",
        "    locationmode=\"country names\",\n",
        "    color=\"estimated_hiv_prevalence_ages_15_49\",\n",
        "    hover_name=\"country_label\",\n",
        "    title=f\"Global HIV Prevalence Among Ages 15–49 ({hiv_latest_year})\",\n",
        "    labels={\"estimated_hiv_prevalence_ages_15_49\": \"HIV prevalence (%)\"},\n",
        "    color_continuous_scale=\"Viridis\",\n",
        ")\n",
        "\n",
        "fig_hiv_map.update_layout(height=600)\n",
        "\n",
        "fig_hiv_map.show()"
      ],
      "id": "ebf155b7",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "HIV prevalence remains highly concentrated in Southern and Eastern Africa. The long-term trend shows the historical development of the epidemic followed by a period of stabilization and decline, consistent with expanded prevention and treatment efforts, including ART.\n",
        "\n",
        "# Health expenditure"
      ],
      "id": "0d047a45"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "fig_health_trend = px.line(\n",
        "    health_expenditure_trend,\n",
        "    x=\"year\",\n",
        "    y=\"health_expenditure\",\n",
        "    markers=True,\n",
        "    title=\"Average Current Health Expenditure per Capita Over Time\",\n",
        "    labels={\n",
        "        \"year\": \"Year\",\n",
        "        \"health_expenditure\": \"Health expenditure (US$ per capita)\"\n",
        "    }\n",
        ")\n",
        "\n",
        "fig_health_trend.update_layout(\n",
        "    height=500,\n",
        "    xaxis_title=\"Year\",\n",
        "    yaxis_title=\"Health expenditure (US$ per capita)\"\n",
        ")\n",
        "\n",
        "fig_health_trend.show()"
      ],
      "id": "806116a1",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "Health expenditure per capita generally increased over time, although the pattern varies substantially between countries. Greater financial resources can support health-system capacity, including HIV prevention, testing, treatment, and ARV services."
      ],
      "id": "adeff3b0"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "top_health_plot = top_health_expenditure.sort_values(\n",
        "    \"health_expenditure\",\n",
        "    ascending=True\n",
        ")\n",
        "\n",
        "fig_health_top10 = px.bar(\n",
        "    top_health_plot,\n",
        "    x=\"health_expenditure\",\n",
        "    y=\"Country Name\",\n",
        "    orientation=\"h\",\n",
        "    title=f\"Top 10 Countries by Health Expenditure per Capita ({health_latest_year})\",\n",
        "    labels={\n",
        "        \"health_expenditure\": \"Health expenditure (US$ per capita)\",\n",
        "        \"Country Name\": \"Country\"\n",
        "    },\n",
        "    text=\"health_expenditure\"\n",
        ")\n",
        "\n",
        "fig_health_top10.update_traces(\n",
        "    texttemplate=\"$%{text:,.0f}\",\n",
        "    textposition=\"outside\"\n",
        ")\n",
        "\n",
        "fig_health_top10.update_layout(\n",
        "    height=550,\n",
        "    xaxis_title=\"Health expenditure (US$ per capita)\",\n",
        "    yaxis_title=\"Country\"\n",
        ")\n",
        "\n",
        "fig_health_top10.show()"
      ],
      "id": "dbfeec72",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "health_expenditure_table = top_health_expenditure[\n",
