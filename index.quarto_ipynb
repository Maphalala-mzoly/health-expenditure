        "\n",
        "health_expenditure_table[\"health_expenditure\"] = health_expenditure_table[\n",
        "    \"health_expenditure\"\n",
        "].round(2)\n",
        "\n",
        "health_expenditure_table = health_expenditure_table.rename(\n",
        "    columns={\n",
        "        \"Country Name\": \"Country\",\n",
        "        \"health_expenditure\": \"Health expenditure (US$ per capita)\",\n",
        "    }\n",
        ")\n",
        "\n",
        "health_expenditure_table"
