    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Filter data for years 2000–2011\n",
        "relationship_data = merged_data[\n",
        "    (merged_data[\"year\"] >= 2000) & (merged_data[\"year\"] <= 2011)\n",
        "].copy()\n",
        "\n",
        "# Get the latest year in the filtered data\n",
        "relationship_latest_year = int(relationship_data[\"year\"].max())\n",
        "\n",
        "# Subset data for the latest year\n",
        "relationship_latest_data = relationship_data[\n",
        "    relationship_data[\"year\"] == relationship_latest_year\n",
        "].copy()"
      ],
      "id": "8f9c9f8d",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "fig_relationship = px.scatter(\n",
