      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "correlation = relationship_data[\n",
        "    [\n",
        "        \"health_expenditure\",\n",
        "        \"estimated_hiv_prevalence_ages_15_49\"\n",
        "    ]\n",
        "].corr().iloc[0, 1]\n",
        "\n",
        "print(\n",
        "    f\"Correlation between health expenditure per capita \"\n",
        "    f\"and HIV prevalence: {correlation:.2f}\"\n",
        ")\n",
        "#| echo: false\n",
        "\n",
        "print(\n",
        "    f\"The correlation coefficient is {correlation:.2f}. \"\n",
        "    \"This describes the strength and direction of the linear association \"\n",
        "    \"between the two variables; it does not establish causation.\"\n",
        ")"
      ],
